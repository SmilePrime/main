@startuml
left to right direction
skinparam packageStyle rectangle

actor "руководитель" as manager
actor "сотрудник" as employee

usecase "Просмотр списка доходов" as UC1
usecase "Просмотр списка расходов" as UC2
usecase "Изменение суммы доходов/расходов" as UC3
usecase "Добавление/\nУдаление пункта доходов" as UC4
usecase "Расчет доходов\nЗа месяц" as UC5
usecase "Сохранение информации" as UC6

manager --> UC1
manager --> UC2
manager --> UC3
manager --> UC4
manager --> UC5
manager --> UC6

employee --> UC1
employee --> UC2
employee --> UC5


@enduml